<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>mcvs</groupId>
    <artifactId>mcvs-experiments</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        The Ludii General Game Playing System is distributed as a single jar (see
        ./lib/Ludii-1.3.14.jar) without a public Maven Central artifact, so it is
        referenced here as a "system" scoped dependency pointing at the local jar.
    -->
    <dependencies>
        <dependency>
            <groupId>com.ludii</groupId>
            <artifactId>ludii</artifactId>
            <version>1.3.14</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Ludii-1.3.14.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>mcvs-experiments</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <!--
                    Bundles the Ludii jar's classes into the final jar so that
                    "java -jar mcvs-experiments.jar" works without needing -cp.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>mcvs.Main</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
