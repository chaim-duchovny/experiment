        (piece Rename piece:"T360" " ")
        (piece Foreground "T360" text:"(3,6)" scale:0.5)
        (piece Rename piece:"T450" " ")
        (piece Foreground "T450" text:"(4,5)" scale:0.5)
        (piece Rename piece:"T460" " ")
